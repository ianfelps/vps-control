{
  "openapi": "3.1.1",
  "info": {
    "title": "VpsControl.Api | v1",
    "version": "1.0.0"
  },
  "paths": {
    "/api/health": {
      "get": {
        "tags": [
          "System"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/audit": {
      "get": {
        "tags": [
          "Audit"
        ],
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/AuditEntryDto"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/alerts": {
      "get": {
        "tags": [
          "Alerts"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Alert"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/system/status": {
      "get": {
        "tags": [
          "System"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SourceStatus"
                }
              }
            }
          }
        }
      }
    },
    "/api/system/snapshot": {
      "get": {
        "tags": [
          "System"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HostSnapshot"
                }
              }
            }
          }
        }
      }
    },
    "/api/system/history": {
      "get": {
        "tags": [
          "System"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/MetricsPoint"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/antiforgery": {
      "get": {
        "tags": [
          "Auth"
        ],
        "responses": {
          "204": {
            "description": "No Content"
          }
        }
      }
    },
    "/api/auth/login": {
      "post": {
        "tags": [
          "Auth"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/logout": {
      "post": {
        "tags": [
          "Auth"
        ],
        "responses": {
          "204": {
            "description": "No Content"
          }
        }
      }
    },
    "/api/auth/me": {
      "get": {
        "tags": [
          "Auth"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CurrentUser"
                }
              }
            }
          }
        }
      }
    },
    "/api/containers": {
      "get": {
        "tags": [
          "Containers"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ContainersSnapshot"
                }
              }
            }
          }
        }
      }
    },
    "/api/containers/{id}": {
      "get": {
        "tags": [
          "Containers"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ContainerDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/containers/{id}/env/reveal": {
      "post": {
        "tags": [
          "Containers"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ContainerDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/containers/{id}/logs": {
      "get": {
        "tags": [
          "Containers"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "tail",
            "in": "query",
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/LogLine"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/containers/{id}/{action}": {
      "post": {
        "tags": [
          "Containers"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "action",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ContainerActionResult"
                }
              }
            }
          }
        }
      }
    },
    "/api/applications": {
      "get": {
        "tags": [
          "Applications"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ApplicationView"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/applications/{slug}": {
      "get": {
        "tags": [
          "Applications"
        ],
        "parameters": [
          {
            "name": "slug",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApplicationDetails"
                }
              }
            }
          },
          "404": {
            "description": "Not Found"
          }
        }
      },
      "put": {
        "tags": [
          "Applications"
        ],
        "parameters": [
          {
            "name": "slug",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateApplicationRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApplicationView"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Alert": {
        "required": [
          "id",
          "severity",
          "source",
          "title",
          "detail"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "severity": {
            "$ref": "#/components/schemas/AlertSeverity"
          },
          "source": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "detail": {
            "type": "string"
          }
        }
      },
      "AlertSeverity": {
        "enum": [
          "warning",
          "critical"
        ]
      },
      "ApplicationDetails": {
        "required": [
          "application",
          "containers"
        ],
        "type": "object",
        "properties": {
          "application": {
            "$ref": "#/components/schemas/ApplicationView"
          },
          "containers": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ContainerView"
            }
          }
        }
      },
      "ApplicationStatus": {
        "enum": [
          "running",
          "degraded",
          "stopped",
          "missing"
        ]
      },
      "ApplicationView": {
        "required": [
          "slug",
          "displayName",
          "description",
          "url",
          "status",
          "containerCount",
          "runningCount",
          "unhealthyCount",
          "cpuPercent",
          "memoryUsageBytes",
          "hasMetadata"
        ],
        "type": "object",
        "properties": {
          "slug": {
            "type": "string"
          },
          "displayName": {
            "type": "string"
          },
          "description": {
            "type": [
              "null",
              "string"
            ]
          },
          "url": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "$ref": "#/components/schemas/ApplicationStatus"
          },
          "containerCount": {
            "type": "integer",
            "format": "int32"
          },
          "runningCount": {
            "type": "integer",
            "format": "int32"
          },
          "unhealthyCount": {
            "type": "integer",
            "format": "int32"
          },
          "cpuPercent": {
            "type": "number",
            "format": "double"
          },
          "memoryUsageBytes": {
            "type": "integer",
            "format": "int64"
          },
          "hasMetadata": {
            "type": "boolean"
          }
        }
      },
      "AuditEntryDto": {
        "required": [
          "id",
          "timestamp",
          "actor",
          "action",
          "target",
          "result",
          "remoteIp",
          "details"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "actor": {
            "type": "string"
          },
          "action": {
            "type": "string"
          },
          "target": {
            "type": [
              "null",
              "string"
            ]
          },
          "result": {
            "type": "string"
          },
          "remoteIp": {
            "type": [
              "null",
              "string"
            ]
          },
          "details": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "ContainerActionResult": {
        "required": [
          "id",
          "action",
          "state"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "action": {
            "type": "string"
          },
          "state": {
            "type": "string"
          }
        }
      },
      "ContainerDetails": {
        "required": [
          "summary",
          "startedAt",
          "finishedAt",
          "exitCode",
          "restartCount",
          "restartPolicy",
          "command",
          "env",
          "labels",
          "mounts",
          "networks"
        ],
        "type": "object",
        "properties": {
          "summary": {
            "$ref": "#/components/schemas/ContainerSummary"
          },
          "startedAt": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          },
          "finishedAt": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          },
          "exitCode": {
            "type": "integer",
            "format": "int32"
          },
          "restartCount": {
            "type": "integer",
            "format": "int32"
          },
          "restartPolicy": {
            "type": "string"
          },
          "command": {
            "type": "string"
          },
          "env": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/EnvVar"
            }
          },
          "labels": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "mounts": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MountInfo"
            }
          },
          "networks": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/NetworkAttachment"
            }
          }
        }
      },
      "ContainerHealth": {
        "enum": [
          "none",
          "starting",
          "healthy",
          "unhealthy"
        ]
      },
      "ContainerStats": {
        "required": [
          "id",
          "cpuPercent",
          "memoryUsageBytes",
          "memoryLimitBytes",
          "networkRxBytes",
          "networkTxBytes",
          "blockReadBytes",
          "blockWriteBytes",
          "pids"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "cpuPercent": {
            "type": "number",
            "format": "double"
          },
          "memoryUsageBytes": {
            "type": "integer",
            "format": "int64"
          },
          "memoryLimitBytes": {
            "type": "integer",
            "format": "int64"
          },
          "networkRxBytes": {
            "type": "integer",
            "format": "int64"
          },
          "networkTxBytes": {
            "type": "integer",
            "format": "int64"
          },
          "blockReadBytes": {
            "type": "integer",
            "format": "int64"
          },
          "blockWriteBytes": {
            "type": "integer",
            "format": "int64"
          },
          "pids": {
            "type": "integer",
            "format": "int32"
          },
          "memoryPercent": {
            "type": "number",
            "format": "double"
          }
        }
      },
      "ContainerSummary": {
        "required": [
          "id",
          "name",
          "image",
          "state",
          "status",
          "health",
          "createdAt",
          "composeProject",
          "composeService",
          "protected",
          "ports"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "image": {
            "type": "string"
          },
          "state": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "health": {
            "$ref": "#/components/schemas/ContainerHealth"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "composeProject": {
            "type": [
              "null",
              "string"
            ]
          },
          "composeService": {
            "type": [
              "null",
              "string"
            ]
          },
          "protected": {
            "type": "boolean"
          },
          "ports": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PortMapping"
            }
          },
          "shortId": {
            "type": [
              "null",
              "string"
            ]
          },
          "running": {
            "type": "boolean"
          }
        }
      },
      "ContainerView": {
        "required": [
          "id",
          "shortId",
          "name",
          "image",
          "state",
          "status",
          "health",
          "createdAt",
          "composeProject",
          "composeService",
          "protected",
          "ports",
          "stats"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "shortId": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "image": {
            "type": "string"
          },
          "state": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "health": {
            "$ref": "#/components/schemas/ContainerHealth"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "composeProject": {
            "type": [
              "null",
              "string"
            ]
          },
          "composeService": {
            "type": [
              "null",
              "string"
            ]
          },
          "protected": {
            "type": "boolean"
          },
          "ports": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PortMapping"
            }
          },
          "stats": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/ContainerStats"
              }
            ]
          }
        }
      },
      "ContainersSnapshot": {
        "required": [
          "items",
          "updatedAt",
          "error"
        ],
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ContainerView"
            }
          },
          "updatedAt": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          },
          "error": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "CpuUsage": {
        "required": [
          "usagePercent",
          "load1",
          "load5",
          "load15"
        ],
        "type": "object",
        "properties": {
          "usagePercent": {
            "type": "number",
            "format": "double"
          },
          "load1": {
            "type": "number",
            "format": "double"
          },
          "load5": {
            "type": "number",
            "format": "double"
          },
          "load15": {
            "type": "number",
            "format": "double"
          }
        }
      },
      "CurrentUser": {
        "required": [
          "username",
          "tailscaleUser",
          "permissions"
        ],
        "type": "object",
        "properties": {
          "username": {
            "type": "string"
          },
          "tailscaleUser": {
            "type": [
              "null",
              "string"
            ]
          },
          "permissions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "DiskUsage": {
        "required": [
          "mountPoint",
          "fileSystem",
          "totalBytes",
          "freeBytes"
        ],
        "type": "object",
        "properties": {
          "mountPoint": {
            "type": "string"
          },
          "fileSystem": {
            "type": "string"
          },
          "totalBytes": {
            "type": "integer",
            "format": "int64"
          },
          "freeBytes": {
            "type": "integer",
            "format": "int64"
          },
          "usedBytes": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "EnvVar": {
        "required": [
          "name",
          "value",
          "masked"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "value": {
            "type": "string"
          },
          "masked": {
            "type": "boolean"
          }
        }
      },
      "HealthResponse": {
        "required": [
          "status",
          "version"
        ],
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          },
          "version": {
            "type": "string"
          }
        }
      },
      "HostInfo": {
        "required": [
          "hostname",
          "osName",
          "kernelVersion",
          "uptime",
          "logicalCores"
        ],
        "type": "object",
        "properties": {
          "hostname": {
            "type": "string"
          },
          "osName": {
            "type": "string"
          },
          "kernelVersion": {
            "type": "string"
          },
          "uptime": {
            "pattern": "^-?(\\d+\\.)?\\d{2}:\\d{2}:\\d{2}(\\.\\d{1,7})?$",
            "type": "string"
          },
          "logicalCores": {
            "type": "integer",
            "format": "int32"
          },
          "uptimeSeconds": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "HostSnapshot": {
        "required": [
          "timestamp",
          "info",
          "cpu",
          "memory",
          "disks",
          "networks"
        ],
        "type": "object",
        "properties": {
          "timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "info": {
            "$ref": "#/components/schemas/HostInfo"
          },
          "cpu": {
            "$ref": "#/components/schemas/CpuUsage"
          },
          "memory": {
            "$ref": "#/components/schemas/MemoryUsage"
          },
          "disks": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DiskUsage"
            }
          },
          "networks": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/NetworkUsage"
            }
          }
        }
      },
      "HttpValidationProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          },
          "errors": {
            "type": "object",
            "additionalProperties": {
