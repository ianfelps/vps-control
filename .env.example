# Copie para .env na VPS (nunca versione o .env).

# GID do grupo vpsctl no host (impresso por deploy/scripts/install-agent.sh).
VPSCTL_GID=

# Senha do admin criada no primeiro start (>= 12 caracteres). Remova após o primeiro login.
VPSCTL_ADMIN_PASSWORD=

# Opcional: identidade Tailscale permitida (ex.: voce@github). Vazio = qualquer membro da tailnet.
VPSCTL_TAILSCALE_USER=
