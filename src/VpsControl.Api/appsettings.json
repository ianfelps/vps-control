{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [ { "Name": "Console" } ]
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Data Source=/data/vpscontrol.db"
  },
  "Auth": {
    "AdminUsername": "admin",
    "TailscaleAllowedUsers": [],
    "SecureCookies": true,
    "SessionHours": 8
  },
  "Metrics": {
    "Source": "Agent",
    "AgentSocketPath": "/run/vps-control/agent.sock",
    "AgentTokenFile": "/run/secrets/agent_token",
    "SampleIntervalSeconds": 2,
    "HistoryMinutes": 60
  },
  "Proxy": {
    "AssumeHttps": true
  },
  "ForwardedHeaders": {
    "KnownNetworks": []
  }
}
