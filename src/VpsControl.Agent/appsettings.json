{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Agent": {
    "SocketPath": "/run/vps-control/agent.sock",
    "TokenFile": "/etc/vps-control/agent.token",
    "MetricsSource": "ProcFs",
    "ContainersSource": "Docker",
    "DockerSocketPath": "/var/run/docker.sock"
  }
}
